---
import Base from '../layouts/Base.astro'
---
<Base titulo="Página no encontrada" indexar={false}>
  <section class="seccion"><div class="envoltura" style="text-align:center">
    <p class="antetitulo">Error 404</p>
    <h1>No encontramos esta página</h1>
    <p class="entrada" style="margin:0 auto 28px">Puede que el enlace haya cambiado. Busca en el catálogo o vuelve al inicio.</p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap"><a class="btn" href="/catalogo">Ver catálogo</a><a class="btn secundario" href="/">Ir al inicio</a></div>
  </div></section>
</Base>
