---
import Base from '../../layouts/Base.astro'
import Portada from '../../components/Portada.astro'
import TarjetaLibro from '../../components/TarjetaLibro.astro'
import Icono from '../../components/Icono.astro'
import IconoWhatsApp from '../../components/IconoWhatsApp.astro'
import { libros, quetzales, type Libro } from '../../lib/datos'
import { SITIO, enlaceWhatsApp } from '../../datos/sitio'

export async function getStaticPaths() {
  const todos = await libros()
  return todos.map((libro) => ({ params: { slug: libro.slug }, props: { libro, todos } }))
}
const { libro, todos } = Astro.props as { libro: Libro; todos: Libro[] }
const parrafos = (libro.sinopsis ?? '').split(/\n{2,}/).filter(Boolean)
const url = new URL(`/libros/${libro.slug}`, Astro.site).href
const resumen = (libro.sinopsis ?? '').replace(/\s+/g, ' ').slice(0, 155)
const descripcion = `${libro.titulo}, de ${libro.autor}${libro.ministerio ? ` (${libro.ministerio})` : ''}. ${resumen}`.slice(0, 200)
const relacionados = todos.filter((l) => l.id !== libro.id && l.categoria === libro.categoria).concat(todos.filter((l) => l.id !== libro.id && l.categoria !== libro.categoria)).slice(0, 4)
const mensajeWa = `Hola, me interesa el libro «${libro.titulo}» de ${libro.autor}. ${url}`
const compartirTexto = `«${libro.titulo}», de ${libro.autor}. Publicaciones Pneuma: ${url}`
const tiendaAmazon = libro.tiendas?.amazon
const tiendaPlay = libro.tiendas?.google_play
const ofertas = [
  libro.impreso && { '@type': 'Offer', price: libro.impreso.precio_gtq.toFixed(2), priceCurrency: 'GTQ', availability: libro.impreso.disponible ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock', url, itemCondition: 'https://schema.org/NewCondition' },
  libro.digital?.precio_compra_gtq != null && { '@type': 'Offer', price: libro.digital.precio_compra_gtq.toFixed(2), priceCurrency: 'GTQ', availability: 'https://schema.org/InStock', url },
].filter(Boolean)
const ld = [
  {
    '@context': 'https://schema.org', '@type': 'Book', name: libro.titulo, author: { '@type': 'Person', name: libro.autor },
    publisher: { '@type': 'Organization', name: SITIO.nombre }, inLanguage: 'es', url, description: libro.sinopsis ?? undefined,
    isbn: libro.isbn ?? undefined, numberOfPages: libro.paginas ?? undefined, genre: libro.categoria ?? undefined,
    image: libro.portada_url ?? undefined, bookFormat: libro.impreso ? 'https://schema.org/Paperback' : 'https://schema.org/EBook', offers: ofertas,
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Catálogo', item: new URL('/catalogo', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: libro.titulo, item: url },
  ] },
]
const datosCarrito = JSON.stringify({ libro_id: libro.id, slug: libro.slug, titulo: libro.titulo, autor: libro.autor, portada_url: libro.portada_url })
---
<Base titulo={`${libro.titulo}, de ${libro.autor}`} descripcion={descripcion} imagen={libro.portada_url ?? undefined} tipo="book" jsonld={ld}>
  <div class="envoltura">
    <nav class="migas" aria-label="Ruta"><a href="/catalogo">Catálogo</a><span aria-hidden="true">/</span>{libro.categoria && <a href={`/catalogo?tema=${encodeURIComponent(libro.categoria)}`}>{libro.categoria}</a>}{libro.categoria && <span aria-hidden="true">/</span>}<span aria-current="page">{libro.titulo}</span></nav>
    <article class="ficha">
      <div class="lateral"><Portada libro={libro} carga="eager" /></div>
      <div>
        {libro.categoria && <span class="etiqueta roja">{libro.categoria}</span>}
        <h1 style="margin-top:12px">{libro.titulo}</h1>
        <p class="autor">{libro.ministerio ? `${libro.autor} · ${libro.ministerio}` : libro.autor}</p>

        <div class="compra" data-compra={datosCarrito}>
          {libro.impreso ? (
            <Fragment>
              <div><span class="precio">{quetzales(libro.impreso.precio_gtq)}<small>libro impreso</small></span></div>
              {libro.impreso.disponible ? (
                <div class="fila">
                  <div class="cantidad">
                    <button type="button" aria-label="Quitar uno" data-menos>−</button>
                    <input type="number" min="1" max="99" value="1" aria-label="Cantidad" data-cantidad inputmode="numeric" />
                    <button type="button" aria-label="Agregar uno" data-mas>+</button>
                  </div>
                  <button class="btn" type="button" data-agregar="impreso" data-precio={libro.impreso.precio_gtq}><Icono n="carrito" />Agregar al carrito</button>
                </div>
              ) : (<p class="nota">Agotado por ahora. Escríbenos y te avisamos cuando haya ejemplares.</p>)}
              <p class="nota">Envío a domicilio en toda Guatemala. El costo del envío se calcula al pagar.</p>
            </Fragment>
          ) : (<p class="nota">Esta obra no se vende impresa.</p>)}
          {libro.digital && (
            <div style="border-top:1px solid var(--linea);padding-top:16px;display:grid;gap:12px">
              <b>También en digital</b>
              <div class="fila">
                {libro.digital.precio_compra_gtq != null && <button class="btn secundario chico" type="button" data-agregar="compra" data-precio={libro.digital.precio_compra_gtq}>Comprar digital {quetzales(libro.digital.precio_compra_gtq)}</button>}
                {libro.digital.precio_alquiler_gtq != null && <button class="btn secundario chico" type="button" data-agregar="alquiler" data-precio={libro.digital.precio_alquiler_gtq}>Alquilar {libro.digital.dias_alquiler} días {quetzales(libro.digital.precio_alquiler_gtq)}</button>}
                {libro.digital.paginas_muestra > 0 && <a class="enlace" href={`${SITIO.lector}/#/muestra/${libro.id}`}>Leer muestra gratis</a>}
              </div>
              <p class="nota">Se lee en el lector de Pneuma, con tu correo. {libro.digital.en_suscripcion && 'Incluido en la suscripción.'}</p>
            </div>
          )}
          <p class="agregado" hidden aria-live="polite" data-agregado>Agregado al carrito. <a class="enlace" href="/carrito">Ir a pagar</a></p>
        </div>

        {libro.sinopsis && <h2 style="font-size:1.5rem">Sinopsis</h2>}{parrafos.length > 0 && <div class="prosa">{parrafos.map((p) => <p>{p}</p>)}</div>}

        <dl class="datos">
          <dt>Autor</dt><dd>{libro.autor}</dd>
          {libro.ministerio && <Fragment><dt>Ministerio</dt><dd>{libro.ministerio}</dd></Fragment>}
          <dt>ISBN</dt><dd>{libro.isbn ?? 'En trámite'}</dd>
          {libro.paginas && <Fragment><dt>Páginas</dt><dd>{libro.paginas}</dd></Fragment>}
          <dt>Editorial</dt><dd>{SITIO.nombre}</dd>
        </dl>

        {(tiendaAmazon || tiendaPlay) && (
          <div style="margin:28px 0">
            <h2 style="font-size:1.2rem">Disponible también en</h2>
            <div class="otras-tiendas">
              {tiendaAmazon && <a class="btn secundario chico" href={tiendaAmazon} target="_blank" rel="noopener">Amazon</a>}
              {tiendaPlay && <a class="btn secundario chico" href={tiendaPlay} target="_blank" rel="noopener">Google Play Libros</a>}
            </div>
          </div>
        )}

        <div style="margin:28px 0;display:grid;gap:12px">
          <h2 style="font-size:1.2rem;margin:0">Compartir</h2>
          <div class="compartir">
            <a href={`https://wa.me/?text=${encodeURIComponent(compartirTexto)}`} target="_blank" rel="noopener" aria-label="Compartir por WhatsApp"><IconoWhatsApp /></a>
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener" aria-label="Compartir en Facebook"><Icono n="facebook" /></a>
            <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(compartirTexto)}`} target="_blank" rel="noopener" aria-label="Compartir en X"><Icono n="x" /></a>
            <button type="button" aria-label="Copiar enlace" data-copiar={url} data-titulo={libro.titulo}><Icono n="enlace" /></button>
            <span class="nota" aria-live="polite" data-copiado></span>
          </div>
          <a class="btn whatsapp" style="justify-self:start" href={enlaceWhatsApp(mensajeWa)} target="_blank" rel="noopener"><IconoWhatsApp />Preguntar por WhatsApp</a>
        </div>
      </div>
    </article>
  </div>

  {relacionados.length > 0 && (
    <section class="seccion honda">
      <div class="envoltura">
        <h2>También te puede interesar</h2>
        <div class="rejilla" style="margin-top:28px">{relacionados.map((l) => <TarjetaLibro libro={l} />)}</div>
      </div>
    </section>
  )}

  <script>
    import { agregar, type Modalidad } from '../../scripts/carrito'
    const caja = document.querySelector<HTMLElement>('[data-compra]')
    if (caja) {
      const base = JSON.parse(caja.dataset.compra!)
      const cant = caja.querySelector<HTMLInputElement>('[data-cantidad]')
      const aviso = caja.querySelector<HTMLElement>('[data-agregado]')!
      const fijar = (n: number) => { if (cant) cant.value = String(Math.max(1, Math.min(99, n || 1))) }
      caja.querySelector('[data-menos]')?.addEventListener('click', () => fijar(Number(cant!.value) - 1))
      caja.querySelector('[data-mas]')?.addEventListener('click', () => fijar(Number(cant!.value) + 1))
      cant?.addEventListener('change', () => fijar(Number(cant.value)))
      caja.querySelectorAll<HTMLButtonElement>('[data-agregar]').forEach((b) => b.addEventListener('click', () => {
        const modalidad = b.dataset.agregar as Modalidad
        agregar({ ...base, modalidad, precio: Number(b.dataset.precio), cantidad: modalidad === 'impreso' ? Number(cant?.value ?? 1) : 1 })
        aviso.hidden = false
      }))
    }
    const copiar = document.querySelector<HTMLButtonElement>('[data-copiar]')
    const copiado = document.querySelector<HTMLElement>('[data-copiado]')!
    copiar?.addEventListener('click', async () => {
      const url = copiar.dataset.copiar!
      if (navigator.share && matchMedia('(pointer: coarse)').matches) { try { await navigator.share({ title: copiar.dataset.titulo, url }); return } catch { /* cancelado */ } }
      try { await navigator.clipboard.writeText(url); copiado.textContent = 'Enlace copiado' } catch { copiado.textContent = url }
    })
  </script>
</Base>
